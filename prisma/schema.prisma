// HP Enterprise HRMS — Prisma Schema (SQLite)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../db/custom.db"
}

// ============================================================
// AUTH & USERS
// ============================================================

model User {
  id               String   @id @default(cuid())
  username         String   @unique
  email            String   @unique
  passwordHash     String
  role             String   @default("EMPLOYEE") // OWNER | SUPER_ADMIN | HR_MANAGER | EMPLOYEE | CLIENT
  clientId         String?  // For CLIENT role users — links to Client record
  mustResetPassword Boolean @default(true)
  locked           Boolean  @default(false)
  lastLoginAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  employee       Employee?
  notifications  Notification[]
  auditLogs      AuditLog[]
  attendanceRecords Attendance[] @relation("AttendanceMarkedBy")
  leaveActions   LeaveAction[]

  @@index([role])
}

// ============================================================
// EMPLOYEES (registration -> approved)
// ============================================================

model Employee {
  id              String   @id @default(cuid())
  employeeCode    String?  @unique // e.g. HPE-0042 — generated on approval
  status          String   @default("PENDING") // PENDING | APPROVED | REJECTED | TERMINATED

  // Personal
  fullName        String
  fatherName      String?
  motherName      String?
  dob             DateTime?
  gender          String?
  maritalStatus   String?
  nationality     String?
  bloodGroup      String?
  mobile          String?
  alternateMobile String?
  email           String
  address         String?
  permanentAddress String?
  emergencyContact String?

  // Identity
  aadhaar         String?
  pan             String?
  uan             String?
  esic            String?
  passport        String?
  drivingLicence  String?

  // Bank
  bankHolder      String?
  bankName        String?
  bankBranch      String?
  bankAccount     String?
  bankIfsc        String?

  // Education (JSON string array of {qualification, specialization, college, year})
  educationJson   String?

  // Experience
  currentDesignation String?
  totalExperience    String?
  relevantExperience String?
  currentCompany     String?
  previousCompany    String?
  currentSalary      String?
  expectedSalary     String?
  noticePeriod       String?

  // Engineering disciplines / project experience / skills (comma separated)
  disciplines    String?
  projectTypes   String?
  skills         String?

  // Employment
  designation    String?
  department     String?
  joinDate       DateTime?
  employmentType String? // Full-time / Contract
  salary         Float?
  // Salary structure (monthly) — used by payroll
  basic          Float?
  hra            Float?
  allowances     Float?
  specialAllowance Float?

  // Links
  userId         String?  @unique
  user           User?    @relation(fields: [userId], references: [id])
  documents      EmployeeDocument[]
  attendance     Attendance[]
  leaves         Leave[]
  payrolls       Payroll[]
  salarySlips    SalarySlip[]
  generatedDocs  GeneratedDocument[]
  projectAssignments ProjectMember[]
  leaveBalance   LeaveBalance?
  onboardingTasks OnboardingTask[]
  offboardingTasks OffboardingTask[]

  reviewedBy     String?
  reviewedAt     DateTime?
  rejectReason   String?
  // Interview & verification workflow
  interviewStatus String? // SCHEDULED | COMPLETED | PASSED | FAILED | NONE
  interviewDate   DateTime?
  interviewNotes  String?
  assignedClientId String?
  documentsVerified Boolean @default(false)
  appliedPortal    String?
  assignedClient  Client?  @relation("AssignedClient", fields: [assignedClientId], references: [id])

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
}

model EmployeeDocument {
  id           String   @id @default(cuid())
  employeeId   String
  documentType String // aadhaar | pan | photo | signature | passbook | resume | certificate ...
  fileName     String
  filePath     String
  mimeType     String?
  uploadedAt   DateTime @default(now())
  verified     Boolean  @default(false)
  verifiedBy   String?
  verifiedAt   DateTime?
  verifyNote   String?

  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, documentType])
}

// ============================================================
// ATTENDANCE
// ============================================================

model Attendance {
  id          String   @id @default(cuid())
  employeeId  String
  date        DateTime
  punchIn     DateTime?
  punchOut    DateTime?
  workingHours Float?  // hours
  overtime    Float?   // hours
  lateArrival Boolean @default(false)
  status      String  @default("PRESENT") // PRESENT | ABSENT | LATE | HALF_DAY | LEAVE | HOLIDAY
  markedBy    String?
  markedById  String?
  // Geolocation captured on punch in/out (no continuous tracking)
  punchInLat      Float?
  punchInLng      Float?
  punchInAddress  String?
  punchOutLat     Float?
  punchOutLng     Float?
  punchOutAddress String?
  // Selfie photos captured on punch in/out
  punchInSelfie   String?
  punchOutSelfie  String?

  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  markedByUser User?   @relation("AttendanceMarkedBy", fields: [markedById], references: [id])

  @@unique([employeeId, date])
  @@index([date])
}

// ============================================================
// LEAVE
// ============================================================

model Leave {
  id          String   @id @default(cuid())
  employeeId  String
  leaveType   String // CL | SL | EL | PL | LOP | WFH
  fromDate    DateTime
  toDate      DateTime
  days        Float
  reason      String
  status      String @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED
  appliedAt   DateTime @default(now())
  reviewedBy  String?
  reviewedAt  DateTime?
  comments    String?

  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  actions     LeaveAction[]

  @@index([employeeId, status])
}

model LeaveAction {
  id        String   @id @default(cuid())
  leaveId   String
  userId    String
  action    String // APPROVED | REJECTED
  comments  String?
  at        DateTime @default(now())

  leave     Leave @relation(fields: [leaveId], references: [id], onDelete: Cascade)
  user      User  @relation(fields: [userId], references: [id])
}

model LeaveBalance {
  id          String  @id @default(cuid())
  employeeId  String  @unique
  casual      Float   @default(12)
  sick        Float   @default(12)
  earned      Float   @default(15)
  usedCasual  Float   @default(0)
  usedSick    Float   @default(0)
  usedEarned  Float   @default(0)
  carriedForward Float @default(0)

  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

// ============================================================
// PAYROLL
// ============================================================

model Payroll {
  id           String   @id @default(cuid())
  employeeId   String
  month        Int      // 1-12
  year         Int
  basic        Float
  hra          Float
  allowances   Float
  specialAllowance Float
  grossSalary  Float
  overtimePay  Float    @default(0)
  lopDays      Float    @default(0)
  lopAmount    Float    @default(0)
  pfEmployee   Float    @default(0)
  pfEmployer   Float    @default(0)
  esiEmployee  Float    @default(0)
  esiEmployer  Float    @default(0)
  professionalTax Float @default(0)
  netSalary    Float
  status       String   @default("GENERATED") // GENERATED | PAID | HELD
  processedAt  DateTime @default(now())
  processedBy  String?

  salarySlip   SalarySlip?
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, month, year])
}

model SalarySlip {
  id          String   @id @default(cuid())
  employeeId  String
  payrollId   String   @unique
  month       Int
  year        Int
  netSalary   Float
  generatedAt DateTime @default(now())

  payroll     Payroll  @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model GeneratedDocument {
  id          String   @id @default(cuid())
  employeeId  String
  docType     String // offer_letter | appointment_letter | id_card | joining_letter | nda | experience_letter | relieving_letter | confirmation_letter | promotion_letter | transfer_letter | warning_letter | no_due_certificate | full_final_settlement
  title       String
  filePath    String?
  metaJson    String?
  generatedAt DateTime @default(now())
  generatedBy String?

  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, docType])
}

// ============================================================
// CLIENTS & PROJECTS
// ============================================================

model Client {
  id           String   @id @default(cuid())
  clientName   String
  companyName  String?
  gst          String?
  email        String?
  phone        String?
  address      String?
  contactsJson String? // JSON array of contact persons
  createdAt    DateTime @default(now())

  projects     Project[]
  workOrders   WorkOrder[]
  invoices     Invoice[]
  assignedEmployees Employee[] @relation("AssignedClient")
}

model Project {
  id          String   @id @default(cuid())
  projectName String
  clientId    String
  site        String?
  startDate   DateTime?
  endDate     DateTime?
  status      String   @default("ACTIVE") // ACTIVE | COMPLETED | ON_HOLD
  description String?
  createdAt   DateTime @default(now())

  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  members     ProjectMember[]
  workOrders  WorkOrder[]
}

model ProjectMember {
  id          String  @id @default(cuid())
  projectId   String
  employeeId  String
  role        String?
  assignedAt  DateTime @default(now())

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([projectId, employeeId])
}

model WorkOrder {
  id          String   @id @default(cuid())
  woNumber    String
  clientId    String
  projectId   String?
  title       String
  value       Float
  startDate   DateTime?
  endDate     DateTime?
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())

  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project     Project? @relation(fields: [projectId], references: [id])
  invoices    Invoice[]
}

model Invoice {
  id          String   @id @default(cuid())
  invoiceNumber String @unique
  clientId    String
  workOrderId String?
  amount      Float
  tax         Float    @default(0)
  total       Float
  status      String   @default("DRAFT") // DRAFT | SENT | PAID | OVERDUE
  issueDate   DateTime @default(now())
  dueDate     DateTime?
  filePath    String?

  client      Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  workOrder   WorkOrder? @relation(fields: [workOrderId], references: [id])
}

// ============================================================
// NOTIFICATIONS & AUDIT
// ============================================================

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("INFO") // INFO | SUCCESS | WARNING | LEAVE | PAYROLL | DOCUMENT | ANNOUNCEMENT
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   String?
  ip        String?
  at        DateTime @default(now())

  user      User? @relation(fields: [userId], references: [id])

  @@index([entity, at])
}

// ============================================================
// SETTINGS
// ============================================================

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  audience  String   @default("ALL") // ALL | EMPLOYEE | ADMIN
  postedBy  String?
  postedAt  DateTime @default(now())
}

// ============================================================
// SUBSCRIPTION REQUESTS
// ============================================================

model SubscriptionRequest {
  id          String   @id @default(cuid())
  companyName String
  contactName String
  email       String
  phone       String?
  address     String?
  plan        String   // free | starter | professional | enterprise
  employeeCount String?
  message     String?
  status      String   @default("NEW") // NEW | CONTACTED | CONVERTED | REJECTED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================================
// ORGANIZATION STRUCTURE
// ============================================================

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique
  description String?
  headName    String?
  headEmail   String?
  status      String   @default("ACTIVE") // ACTIVE | INACTIVE
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
}

model Designation {
  id          String   @id @default(cuid())
  title       String   @unique
  level       String?  // Junior | Mid | Senior | Lead | Manager | Director
  department  String?
  minSalary   Float?
  maxSalary   Float?
  description String?
  status      String   @default("ACTIVE") // ACTIVE | INACTIVE
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
}

model Branch {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  address     String?
  city        String?
  state       String?
  pincode     String?
  phone       String?
  email       String?
  isHead      Boolean  @default(false)
  status      String   @default("ACTIVE") // ACTIVE | INACTIVE
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
}

// ============================================================
// VENDORS
// ============================================================

model Vendor {
  id          String   @id @default(cuid())
  vendorName  String
  companyName String?
  gst         String?
  email       String?
  phone       String?
  address     String?
  category    String?  // Equipment | Material | Service | Contractor | Consultant
  pan         String?
  bankName    String?
  bankAccount String?
  bankIfsc    String?
  rating      Float?   // 1-5
  status      String   @default("ACTIVE") // ACTIVE | INACTIVE | BLACKLISTED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
}

// ============================================================
// RECRUITMENT
// ============================================================

model JobPosting {
  id          String   @id @default(cuid())
  title       String
  department  String?
  designation String?
  location    String?
  type        String   @default("FULL_TIME") // FULL_TIME | CONTRACT | PART_TIME | INTERNSHIP
  experience   String?
  salaryMin   Float?
  salaryMax   Float?
  description String?
  requirements String?
  status      String   @default("OPEN") // DRAFT | OPEN | CLOSED | FILLED
  postedBy    String?
  postedAt    DateTime @default(now())
  closedAt    DateTime?

  candidates  Candidate[]

  @@index([status])
}

model Candidate {
  id          String   @id @default(cuid())
  fullName    String
  email       String
  phone       String?
  resume      String?
  experience  String?
  currentCompany String?
  currentCtc  Float?
  expectedCtc Float?
  noticePeriod String?
  skills      String?
  source      String?  // Referral | JobPortal | LinkedIn | Website | WalkIn | Other
  status      String   @default("NEW") // NEW | SCREENING | SHORTLISTED | INTERVIEW | OFFERED | HIRED | REJECTED | WITHDRAWN
  jobPostingId String?
  remarks     String?
  appliedAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  jobPosting  JobPosting? @relation(fields: [jobPostingId], references: [id])

  @@index([status])
}

// ============================================================
// ONBOARDING & OFFBOARDING
// ============================================================

model OnboardingTask {
  id          String   @id @default(cuid())
  employeeId  String
  task        String
  category    String?  // Documents | IT | HR | Finance | Training | General
  dueDate     DateTime?
  status      String   @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED | SKIPPED
  completedBy String?
  completedAt DateTime?
  notes       String?
  createdAt   DateTime @default(now())

  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, status])
}

model OffboardingTask {
  id          String   @id @default(cuid())
  employeeId  String
  task        String
  category    String?  // Documents | IT | HR | Finance | Assets | General
  dueDate     DateTime?
  status      String   @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED | SKIPPED
  completedBy String?
  completedAt DateTime?
  notes       String?
  createdAt   DateTime @default(now())

  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, status])
}

// ============================================================
// PERFORMANCE & GOALS
// ============================================================

model PerformanceReview {
  id          String   @id @default(cuid())
  employeeId  String
  reviewPeriod String  // Q1 | Q2 | Q3 | Q4 | H1 | H2 | Annual
  year        Int
  rating      Float?   // 1-5
  strengths   String?
  improvements String?
  goals       String?
  feedback    String?
  reviewerId  String?
  reviewerName String?
  status      String   @default("DRAFT") // DRAFT | SUBMITTED | REVIEWED | COMPLETED
  reviewedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([employeeId, reviewPeriod, year])
  @@index([employeeId])
}

model Goal {
  id          String   @id @default(cuid())
  employeeId  String
  title       String
  description String?
  category    String?  // Performance | Learning | Project | Personal
  priority    String   @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  progress    Float    @default(0) // 0-100
  targetDate  DateTime?
  status      String   @default("NOT_STARTED") // NOT_STARTED | IN_PROGRESS | ON_TRACK | AT_RISK | COMPLETED | CANCELLED
  weight      Float?   // For weighted goal scoring
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([employeeId, status])
}

// ============================================================
// TRAINING & LEARNING
// ============================================================

model TrainingCourse {
  id          String   @id @default(cuid())
  title       String
  description String?
  category    String?  // Safety | Technical | SoftSkills | Compliance | Leadership
  duration    String?  // e.g. "2 hours", "3 days"
  mode        String?  // Online | Offline | Hybrid
  instructor  String?
  maxParticipants Int?
  status      String   @default("ACTIVE") // ACTIVE | INACTIVE | ARCHIVED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  enrollments TrainingEnrollment[]

  @@index([status])
}

model TrainingEnrollment {
  id          String   @id @default(cuid())
  courseId    String
  employeeId  String
  status      String   @default("ENROLLED") // ENROLLED | IN_PROGRESS | COMPLETED | FAILED | CANCELLED
  enrolledAt  DateTime @default(now())
  completedAt DateTime?
  score       Float?   // 0-100
  certificatePath String?
  feedback    String?

  course      TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, employeeId])
  @@index([employeeId])
}

// ============================================================
// EXPENSES
// ============================================================

model Expense {
  id          String   @id @default(cuid())
  employeeId  String
  category    String   // Travel | Food | Accommodation | Medical | Communication | Equipment | Other
  amount      Float
  description String
  date        DateTime
  receiptPath String?
  status      String   @default("PENDING") // PENDING | APPROVED | REJECTED | REIMBURSED
  approvedBy  String?
  approvedAt  DateTime?
  remarks     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([employeeId, status])
  @@index([status])
}

// ============================================================
// ASSETS & INVENTORY
// ============================================================

model Asset {
  id          String   @id @default(cuid())
  name        String
  category    String   // Laptop | Desktop | Phone | Vehicle | Equipment | Furniture | Other
  serialNumber String?
  make        String?
  model       String?
  purchaseDate DateTime?
  purchaseCost Float?
  currentValue  Float?
  warrantyExpiry DateTime?
  status      String   @default("AVAILABLE") // AVAILABLE | ASSIGNED | IN_REPAIR | DISPOSED | LOST
  location    String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignments AssetAssignment[]

  @@index([status])
}

model AssetAssignment {
  id          String   @id @default(cuid())
  assetId     String
  employeeId  String
  assignedAt  DateTime @default(now())
  returnedAt  DateTime?
  condition   String?  // Good | Fair | Damaged
  notes       String?

  asset       Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

// ============================================================
// AI KNOWLEDGE BASE
// ============================================================

model KnowledgeBase {
  id          String   @id @default(cuid())
  category    String
  question    String
  answer      String
  tags        String?
  keywords    String?
  enabled     Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}

// ============================================================
// TEMPLATES
// ============================================================

model EmailTemplate {
  id          String   @id @default(cuid())
  name        String   @unique
  subject     String
  body        String   // HTML body
  variables   String?  // JSON array of variable placeholders
  category    String?  // onboarding | leave | payroll | general
  status      String   @default("ACTIVE") // ACTIVE | INACTIVE
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model NotificationTemplate {
  id          String   @id @default(cuid())
  name        String   @unique
  title       String
  body        String
  type        String?  // push | email | sms | in_app
  category    String?  // leave | payroll | attendance | general
  status      String   @default("ACTIVE") // ACTIVE | INACTIVE
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================================
// SUBSCRIPTION PLANS
// ============================================================

model SubscriptionPlan {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  priceINR    Float?
  priceUSD    Float?
  interval    String   @default("MONTHLY") // MONTHLY | YEARLY
  maxEmployees Int?
  features    String?  // JSON array of features
  status      String   @default("ACTIVE") // ACTIVE | INACTIVE
  trialDays   Int      @default(14)
  sortOrder   Int      @default(0)
  isPopular   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================================
// FEATURE FLAGS & SYSTEM
// ============================================================

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  enabled     Boolean  @default(false)
  environments String? // JSON array: ["production", "staging"]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PaymentGateway {
  id          String   @id @default(cuid())
  name        String   @unique
  type        String   // razorpay | stripe | upi | bank_transfer
  apiKey      String?
  apiSecret   String?
  merchantId  String?
  isDefault   Boolean  @default(false)
  upiId       String?  // For UPI
  bankName    String?
  bankAccount String?
  bankIfsc    String?
  status      String   @default("ACTIVE") // ACTIVE | INACTIVE
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
