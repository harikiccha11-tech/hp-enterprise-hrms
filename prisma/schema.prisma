// HP Enterprise HPHRMS — Dual-Mode Prisma Schema (PostgreSQL)
// Supports: HRMS SaaS | Manpower Supply | Hybrid


generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// ACCOUNTS (Multi-tenant Organizations)
// ============================================================

model Account {
  id                String   @id @default(cuid())
  organizationName  String
  accountType       String   @default("hrms_saas") // hrms_saas | manpower_supply | hybrid
  status            String   @default("active")     // active | trial | suspended | cancelled
  billingContactEmail String?
  billingPhone      String?
  gstNumber         String?
  panNumber         String?
  billingAddress    String?
  city              String?
  state             String?
  pincode           String?
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  expiresAt         DateTime?

  users             User[]
  employees         Employee[]
  siteAssignments   SiteAssignment[]
  invoices          Invoice[]
  attendance        Attendance[]
  leaves            Leave[]
  payrolls          Payroll[]
  salarySlips       SalarySlip[]
  auditLogs         AuditLog[]
  aiConversations   AiConversation[]
  aiMessages        AiMessage[]
  aiInsights        AiInsight[]
  aiUsageLedger     AiUsageLedger[]
  notifications     Notification[]
  clientBranding    ClientBranding?
  clientSites       ClientSite[]
  timesheets        Timesheet[]
  generatedDocuments GeneratedDocument[] @relation("GeneratedDocAccount")
  employeeDocuments EmployeeDocument[]
  vendors           Vendor[] @relation("VendorAccount")
  candidates                Candidate[] @relation("CandidateAccount")
  candidateApplications      CandidateApplication[] @relation("CandAppAccount")
  jobPostings               JobPosting[] @relation("JobPostingAccount")
  interviews                Interview[] @relation("InterviewAccount")
  assets                    Asset[] @relation("AssetAccount")

  @@index([status])
  @@index([accountType])
}

// ============================================================
// AUTH & USERS
// ============================================================

model User {
  id               String   @id @default(cuid())
  username         String   @unique
  email            String   @unique
  passwordHash     String
  role             String   @default("EMPLOYEE") // OWNER | SUPER_ADMIN | HR_MANAGER | EMPLOYEE | CLIENT | CANDIDATE
  clientId         String?  // Legacy: For CLIENT role users — links to Client record
  // Dual-mode fields
  accountId        String?
  clientRole       String   @default("employee") // admin | hr | manager | employee | viewer
  // System fields
  mustResetPassword Boolean @default(true)
  locked           Boolean  @default(false)
  lastLoginAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  account          Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  employee         Employee?
  candidate        Candidate?
  notifications    Notification[]
  auditLogs        AuditLog[]
  attendanceRecords Attendance[] @relation("AttendanceMarkedBy")
  leaveActions     LeaveAction[]
  aiConversations  AiConversation[]

  @@index([role])
  @@index([accountId])
}

// ============================================================
// EMPLOYEES (registration -> approved)
// ============================================================

model Employee {
  id              String   @id @default(cuid())
  employeeCode    String?  @unique // e.g. HPE-0042 — generated on approval
  status          String   @default("PENDING") // PENDING | APPROVED | REJECTED | TERMINATED | ACTIVE | INACTIVE | ON_LEAVE | CONTRACT_ENDED
  // Dual-mode: employee type
  employeeType    String   @default("internal") // internal | hp_deployed
  accountId       String?

  // Personal
  fullName        String
  fatherName      String?
  motherName      String?
  dob             DateTime?
  gender          String?
  maritalStatus   String?
  nationality     String?
  bloodGroup      String?
  mobile          String?
  alternateMobile String?
  email           String
  address         String?
  permanentAddress String?
  emergencyContact String?

  // Identity
  aadhaar         String?
  pan             String?
  uan             String?
  esic            String?
  passport        String?
  drivingLicence  String?

  // Bank
  bankHolder      String?
  bankName        String?
  bankBranch      String?
  bankAccount     String?
  bankIfsc        String?

  // Education (JSON string array of {qualification, specialization, college, year})
  educationJson   String?

  // Experience
  currentDesignation String?
  totalExperience    String?
  relevantExperience String?
  currentCompany     String?
  previousCompany    String?
  currentSalary      String?
  expectedSalary     String?
  noticePeriod       String?

  // Engineering disciplines / project experience / skills (comma separated)
  disciplines    String?
  projectTypes   String?
  skills         String?

  // Employment
  designation    String?
  department     String?
  joinDate       DateTime?
  employmentType String? // Full-time / Contract
  salary         Float?
  // Salary structure (monthly) — used by payroll
  basic          Float?
  hra            Float?
  allowances     Float?
  specialAllowance Float?

  // Links
  userId         String?  @unique
  user           User?    @relation(fields: [userId], references: [id])
  account        Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  documents      EmployeeDocument[]
  attendance     Attendance[]
  leaves         Leave[]
  payrolls       Payroll[]
  salarySlips    SalarySlip[]
  generatedDocs  GeneratedDocument[] @relation("GeneratedDocEmployee")
  projectAssignments ProjectMember[]
  leaveBalance   LeaveBalance?
  onboardingTasks OnboardingTask[]
  offboardingTasks OffboardingTask[]
  siteAssignments SiteAssignment[]
  timesheetLines  TimesheetLine[]
  invoiceLineItems InvoiceLineItem[]

  reviewedBy     String?
  reviewedAt     DateTime?
  rejectReason   String?
  // Interview & verification workflow
  interviewStatus String? // SCHEDULED | COMPLETED | PASSED | FAILED | NONE
  interviewDate   DateTime?
  interviewNotes  String?
  assignedClientId String?
  documentsVerified Boolean @default(false)
  appliedPortal    String?
  assignedClient  Client?  @relation("AssignedClient", fields: [assignedClientId], references: [id])

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
  @@index([accountId])
  @@index([employeeType])
  @@unique([accountId, employeeCode])
}

model EmployeeDocument {
  id           String   @id @default(cuid())
  accountId    String?
  employeeId   String
  documentType String // aadhaar | pan | photo | signature | passbook | resume | certificate ...
  fileName     String
  filePath     String
  mimeType     String?
  expiryDate   DateTime?
  clientVisible Boolean @default(false)
  uploadedAt   DateTime @default(now())
  verified     Boolean  @default(false)
  verifiedBy   String?
  verifiedAt   DateTime?
  verifyNote   String?

  account      Account?  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, documentType])
  @@index([expiryDate])
}

// ============================================================
// SITE ASSIGNMENTS (Manpower Supply Deployments)
// ============================================================

model SiteAssignment {
  id              String    @id @default(cuid())
  accountId       String
  employeeId      String
  siteName        String
  location        String?
  deploymentDate  DateTime
  expectedEndDate DateTime?
  actualEndDate   DateTime?
  dailyRate       Float
  status          String    @default("active") // active | completed | on_hold | cancelled
  clientVisible   Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdByUserId String?

  account         Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  invoiceLineItems InvoiceLineItem[]

  @@index([accountId])
  @@index([employeeId])
  @@index([status])
}

// ============================================================
// ATTENDANCE
// ============================================================

model Attendance {
  id          String   @id @default(cuid())
  employeeId  String
  accountId   String?
  date        DateTime
  punchIn     DateTime?
  punchOut    DateTime?
  workingHours Float?  // hours
  overtime    Float?   // hours
  lateArrival Boolean @default(false)
  status      String  @default("PRESENT") // PRESENT | ABSENT | LATE | HALF_DAY | LEAVE | HOLIDAY | WFH | ON_LEAVE
  markedBy    String?
  markedById  String?
  // Geolocation captured on punch in/out (no continuous tracking)
  punchInLat      Float?
  punchInLng      Float?
  punchInAddress  String?
  punchOutLat     Float?
  punchOutLng     Float?
  punchOutAddress String?
  // Selfie photos captured on punch in/out
  punchInSelfie   String?
  punchOutSelfie  String?

  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  markedByUser User?   @relation("AttendanceMarkedBy", fields: [markedById], references: [id])
  account     Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([date])
  @@index([accountId])
}

// ============================================================
// LEAVE
// ============================================================

model Leave {
  id          String   @id @default(cuid())
  employeeId  String
  accountId   String?
  leaveType   String // CL | SL | EL | PL | LOP | WFH | casual | sick | annual | unpaid | maternity | paternity
  fromDate    DateTime
  toDate      DateTime
  days        Float
  reason      String
  status      String @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED
  appliedAt   DateTime @default(now())
  reviewedBy  String?
  reviewedAt  DateTime?
  comments    String?

  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  account     Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  actions     LeaveAction[]

  @@index([employeeId, status])
  @@index([accountId])
}

model LeaveAction {
  id        String   @id @default(cuid())
  leaveId   String
  userId    String
  action    String // APPROVED | REJECTED
  comments  String?
  at        DateTime @default(now())

  leave     Leave @relation(fields: [leaveId], references: [id], onDelete: Cascade)
  user      User  @relation(fields: [userId], references: [id])
}

model LeaveBalance {
  id          String  @id @default(cuid())
  employeeId  String  @unique
  casual      Float   @default(12)
  sick        Float   @default(12)
  earned      Float   @default(15)
  usedCasual  Float   @default(0)
  usedSick    Float   @default(0)
  usedEarned  Float   @default(0)
  carriedForward Float @default(0)

  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

// ============================================================
// PAYROLL
// ============================================================

model Payroll {
  id           String   @id @default(cuid())
  employeeId   String
  accountId    String?
  month        Int      // 1-12
  year         Int
  basic        Float
  hra          Float
  allowances   Float
  specialAllowance Float
  grossSalary  Float
  overtimePay  Float    @default(0)
  lopDays      Float    @default(0)
  lopAmount    Float    @default(0)
  pfEmployee   Float    @default(0)
  pfEmployer   Float    @default(0)
  esiEmployee  Float    @default(0)
  esiEmployer  Float    @default(0)
  professionalTax Float @default(0)
  incomeTaxDeduction Float @default(0)
  netSalary    Float
  status       String   @default("GENERATED") // GENERATED | PAID | HELD | draft | generated | approved | processed
  processedAt  DateTime @default(now())
  processedBy  String?

  salarySlip   SalarySlip?
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  account      Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([employeeId, month, year])
  @@index([accountId])
}

model SalarySlip {
  id          String   @id @default(cuid())
  employeeId  String
  accountId   String?
  payrollId   String   @unique
  month       Int
  year        Int
  netSalary   Float
  generatedAt DateTime @default(now())

  payroll     Payroll  @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  account     Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

// ============================================================
// CLIENTS & PROJECTS (Legacy + Enhanced)
// ============================================================

model Client {
  id           String   @id @default(cuid())
  clientName   String
  companyName  String?
  gst          String?
  email        String?
  phone        String?
  address      String?
  contactsJson String? // JSON array of contact persons
  createdAt    DateTime @default(now())

  projects     Project[]
  workOrders   WorkOrder[]
  invoices     Invoice[]
  assignedEmployees Employee[] @relation("AssignedClient")
}

model Project {
  id          String   @id @default(cuid())
  projectName String
  clientId    String
  site        String?
  startDate   DateTime?
  endDate     DateTime?
  status      String   @default("ACTIVE") // ACTIVE | COMPLETED | ON_HOLD
  description String?
  createdAt   DateTime @default(now())

  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  members     ProjectMember[]
  workOrders  WorkOrder[]
}

model ProjectMember {
  id          String  @id @default(cuid())
  projectId   String
  employeeId  String
  role        String?
  assignedAt  DateTime @default(now())

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([projectId, employeeId])
}

model WorkOrder {
  id          String   @id @default(cuid())
  woNumber    String
  clientId    String
  projectId   String?
  title       String
  value       Float
  startDate   DateTime?
  endDate     DateTime?
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())

  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project     Project? @relation(fields: [projectId], references: [id])
  invoices    Invoice[]
}

// ============================================================
// INVOICES (Dual-mode: Project billing + Manpower supply billing)
// ============================================================

model Invoice {
  id                 String   @id @default(cuid())
  invoiceNumber      String   @unique
  // Legacy fields
  clientId           String?
  workOrderId        String?
  amount             Float?
  tax                Float    @default(0)
  total              Float?
  issueDate          DateTime @default(now())
  dueDate            DateTime?
  filePath           String?
  status             String   @default("DRAFT") // DRAFT | SENT | PAID | OVERDUE | draft | sent | overdue | paid | cancelled
  // Dual-mode: Account-based invoicing (manpower supply)
  accountId          String?
  billingPeriodStart DateTime?
  billingPeriodEnd   DateTime?
  gstAmount          Float?
  finalAmount        Float?
  paymentDueDate     DateTime?
  paymentDate        DateTime?
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  client             Client?    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  workOrder          WorkOrder? @relation(fields: [workOrderId], references: [id])
  account            Account?   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  lineItems          InvoiceLineItem[]

  @@index([accountId])
  @@index([status])
  @@index([issueDate])
  @@unique([accountId, invoiceNumber])
}

model InvoiceLineItem {
  id               String  @id @default(cuid())
  invoiceId        String
  siteAssignmentId String?
  employeeId       String
  dailyRate        Float
  daysDeployed     Int
  lineTotal        Float
  createdAt        DateTime @default(now())

  invoice          Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  siteAssignment   SiteAssignment? @relation(fields: [siteAssignmentId], references: [id])
  employee         Employee       @relation(fields: [employeeId], references: [id])

  @@index([invoiceId])
  @@index([employeeId])
}

// ============================================================
// NOTIFICATIONS & AUDIT
// ============================================================

// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id            String    @id @default(cuid())
  accountId     String?
  userId        String?
  insightId     String?   @map("insight_id")
  channel       String    @default("in_app")
  status        String    @default("queued")
  title         String       
  body          String       
  type          String    @default("INFO")
  actionUrl     String?   @map("action_url")
  severity      String    @default("info")
  read          Boolean   @default(false)
  scheduledFor  DateTime? @map("scheduled_for")
  sentAt        DateTime? @map("sent_at")
  readAt        DateTime? @map("read_at")
  createdAt     DateTime  @default(now())

  account      Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, status, createdAt(sort: Desc)])
  @@index([accountId, createdAt(sort: Desc)])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  accountId String?
  action    String
  entity    String
  entityId  String?
  details   String?
  oldValues String?  // JSON
  newValues String?  // JSON
  ip        String?
  at        DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id])
  account   Account? @relation(fields: [accountId], references: [id])

  @@index([entity, at])
  @@index([accountId])
}

// ============================================================
// SETTINGS
// ============================================================

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  audience  String   @default("ALL") // ALL | EMPLOYEE | ADMIN
  postedBy  String?
  postedAt  DateTime @default(now())
}

// ============================================================
// SUBSCRIPTION REQUESTS
// ============================================================

model SubscriptionRequest {
  id          String   @id @default(cuid())
  companyName String
  contactName String
  email       String
  phone       String?
  address     String?
  plan        String   // free | starter | professional | enterprise
  employeeCount String?
  message     String?
  status      String   @default("NEW") // NEW | CONTACTED | CONVERTED | REJECTED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================================
// ORGANIZATION STRUCTURE
// ============================================================

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique
  description String?
  headName    String?
  headEmail   String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
}

model Designation {
  id          String   @id @default(cuid())
  title       String   @unique
  level       String?
  department  String?
  minSalary   Float?
  maxSalary   Float?
  description String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
}

model Branch {
  id          String   @id @default(cuid())
  name        String
  code        String   @unique
  address     String?
  city        String?
  state       String?
  pincode     String?
  phone       String?
  email       String?
  isHead      Boolean  @default(false)
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
}

// ============================================================
// VENDORS
// ============================================================

model Vendor {
  id          String   @id @default(cuid())
  vendorName  String
  companyName String?
  gst         String?
  email       String?
  phone       String?
  address     String?
  category    String?
  pan         String?
  bankName    String?
  bankAccount String?
  bankIfsc    String?
  rating      Float?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  accountId  String
  account   Account @relation("VendorAccount", fields: [accountId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([accountId])
}

// ============================================================
// RECRUITMENT
// ============================================================

model JobPosting {
  id          String   @id @default(cuid())
  title       String
  department  String?
  designation String?
  location    String?
  type        String   @default("FULL_TIME") // FULL_TIME | PART_TIME | CONTRACT | INTERNSHIP | FREELANCE
  experience   String?
  salaryMin   Float?
  salaryMax   Float?
  description String?
  requirements String?
  status      String   @default("OPEN") // DRAFT | OPEN | CLOSED | FILLED | ARCHIVED
  isPublic    Boolean  @default(true)
  postedBy    String?
  postedAt    DateTime @default(now())
  closedAt    DateTime?
  accountId   String?

  candidates           Candidate[]
  candidateApplications CandidateApplication[]
  interviews           Interview[]
  account              Account? @relation("JobPostingAccount", fields: [accountId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([accountId])
}

model Candidate {
  id             String   @id @default(cuid())
  fullName       String
  email          String
  phone          String?
  resume         String?
  experience     String?
  education      String?    // JSON array of education entries
  summary        String?    // Professional summary / bio
  currentCompany String?
  currentCtc     Float?
  expectedCtc    Float?
  noticePeriod   String?
  skills         String?
  source         String?
  status         String   @default("NEW")
  jobPostingId   String?
  userId         String?   @unique
  remarks        String?
  appliedAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  jobPosting             JobPosting? @relation(fields: [jobPostingId], references: [id])
  user                   User?       @relation(fields: [userId], references: [id])
  accountId              String
  account                Account @relation("CandidateAccount", fields: [accountId], references: [id], onDelete: Cascade)
  candidateApplications  CandidateApplication[]
  interviews             Interview[]

  @@index([status])
  @@index([accountId])
  @@index([userId])
}

// ============================================================
// CANDIDATE APPLICATIONS (Portal-authenticated job applications)
// ============================================================

model CandidateApplication {
  id            String   @id @default(cuid())
  candidateId   String
  jobPostingId  String
  status        String   @default("APPLIED") // APPLIED | SCREENING | SHORTLISTED | INTERVIEW | OFFER | REJECTED | WITHDRAWN | HIRED
  coverLetter   String?
  appliedDate   DateTime @default(now())
  updatedAt     DateTime @updatedAt
  accountId     String

  candidate     Candidate  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobPosting    JobPosting @relation(fields: [jobPostingId], references: [id])
  account       Account   @relation("CandAppAccount", fields: [accountId], references: [id], onDelete: Cascade)
  interviews    Interview[]

  @@unique([candidateId, jobPostingId])
  @@index([candidateId])
  @@index([jobPostingId])
  @@index([status])
  @@index([accountId])
}

// ============================================================
// INTERVIEWS
// ============================================================

model Interview {
  id                     String   @id @default(cuid())
  candidateApplicationId  String?
  candidateId            String
  jobPostingId           String
  date                   DateTime
  time                   String   // e.g. "10:00 AM"
  type                   String   // TECHNICAL | HR | BEHAVIORAL | FINAL | PANEL
  status                 String   @default("SCHEDULED") // SCHEDULED | COMPLETED | CANCELLED | NO_SHOW | RESCHEDULED
  interviewerName        String?
  interviewerId          String?
  notes                  String?
  location               String?  // meeting link or physical location
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  accountId              String

  candidateApplication   CandidateApplication? @relation(fields: [candidateApplicationId], references: [id])
  candidate              Candidate  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobPosting             JobPosting @relation(fields: [jobPostingId], references: [id])
  account                Account    @relation("InterviewAccount", fields: [accountId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@index([jobPostingId])
  @@index([status])
  @@index([accountId])
}

// ============================================================
// ONBOARDING & OFFBOARDING
// ============================================================

model OnboardingTask {
  id          String   @id @default(cuid())
  employeeId  String
  task        String
  category    String?
  dueDate     DateTime?
  status      String   @default("PENDING")
  completedBy String?
  completedAt DateTime?
  notes       String?
  createdAt   DateTime @default(now())

  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, status])
}

model OffboardingTask {
  id          String   @id @default(cuid())
  employeeId  String
  task        String
  category    String?
  dueDate     DateTime?
  status      String   @default("PENDING")
  completedBy String?
  completedAt DateTime?
  notes       String?
  createdAt   DateTime @default(now())

  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, status])
}

// ============================================================
// PERFORMANCE & GOALS
// ============================================================

model PerformanceReview {
  id          String   @id @default(cuid())
  employeeId  String
  reviewPeriod String
  year        Int
  rating      Float?
  strengths   String?
  improvements String?
  goals       String?
  feedback    String?
  reviewerId  String?
  reviewerName String?
  status      String   @default("DRAFT")
  reviewedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([employeeId, reviewPeriod, year])
  @@index([employeeId])
}

model Goal {
  id          String   @id @default(cuid())
  employeeId  String
  title       String
  description String?
  category    String?
  priority    String   @default("MEDIUM")
  progress    Float    @default(0)
  targetDate  DateTime?
  status      String   @default("NOT_STARTED")
  weight      Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([employeeId, status])
}

// ============================================================
// TRAINING & LEARNING
// ============================================================

model TrainingCourse {
  id          String   @id @default(cuid())
  title       String
  description String?
  category    String?
  duration    String?
  mode        String?
  instructor  String?
  maxParticipants Int?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  enrollments TrainingEnrollment[]

  @@index([status])
}

model TrainingEnrollment {
  id          String   @id @default(cuid())
  courseId    String
  employeeId  String
  status      String   @default("ENROLLED")
  enrolledAt  DateTime @default(now())
  completedAt DateTime?
  score       Float?
  certificatePath String?
  feedback    String?

  course      TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, employeeId])
  @@index([employeeId])
}

// ============================================================
// EXPENSES
// ============================================================

model Expense {
  id          String   @id @default(cuid())
  employeeId  String
  category    String
  amount      Float
  description String
  date        DateTime
  receiptPath String?
  status      String   @default("PENDING")
  approvedBy  String?
  approvedAt  DateTime?
  remarks     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([employeeId, status])
  @@index([status])
}

// ============================================================
// ASSETS & INVENTORY
// ============================================================

model Asset {
  id          String   @id @default(cuid())
  name        String
  category    String
  serialNumber String?
  make        String?
  model       String?
  purchaseDate DateTime?
  purchaseCost Float?
  currentValue  Float?
  warrantyExpiry DateTime?
  status      String   @default("AVAILABLE")
  location    String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignments AssetAssignment[]
  accountId  String
  account   Account @relation("AssetAccount", fields: [accountId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([accountId])
}

model AssetAssignment {
  id          String   @id @default(cuid())
  assetId     String
  employeeId  String
  assignedAt  DateTime @default(now())
  returnedAt  DateTime?
  condition   String?
  notes       String?

  asset       Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

// ============================================================
// AI KNOWLEDGE BASE
// ============================================================

model KnowledgeBase {
  id          String   @id @default(cuid())
  category    String
  question    String
  answer      String
  tags        String?
  keywords    String?
  enabled     Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}

// ============================================================
// TEMPLATES
