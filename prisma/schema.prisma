model EmailTemplate {
  id          String   @id @default(cuid())
  name        String   @unique
  subject     String
  body        String
  variables   String?
  category    String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model NotificationTemplate {
  id          String   @id @default(cuid())
  name        String   @unique
  title       String
  body        String
  type        String?
  category    String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================================
// SUBSCRIPTION PLANS
// ============================================================

model SubscriptionPlan {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  priceINR    Float?
  priceUSD    Float?
  interval    String   @default("MONTHLY")
  maxEmployees Int?
  features    String?
  status      String   @default("ACTIVE")
  trialDays   Int      @default(14)
  sortOrder   Int      @default(0)
  isPopular   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================================
// FEATURE FLAGS & SYSTEM
// ============================================================

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  enabled     Boolean  @default(false)
  environments String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PaymentGateway {
  id          String   @id @default(cuid())
  name        String   @unique
  type        String
  apiKey      String?
  apiSecret   String?
  merchantId  String?
  isDefault   Boolean  @default(false)
  upiId       String?
  bankName    String?
  bankAccount String?
  bankIfsc    String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================================
// AI CORE — Phase 1
// ============================================================

model AiConversation {
  id            String   @id @default(cuid())
  accountId     String
  userId        String
  agent         String   @default("hr_assistant")
  title         String?
  pinned        Boolean  @default(false)
  archived      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  account       Account  @relation(fields: [accountId], references: [id])
  user          User     @relation(fields: [userId], references: [id])
  messages      AiMessage[]

  @@index([accountId])
  @@index([userId, updatedAt(sort: Desc)])
}

model AiMessage {
  id             String   @id @default(cuid())
  conversationId String
  accountId      String
  role           String   // user | assistant | tool | system
  content        String?     
  toolName       String?  @map("tool_name")
  toolInput      Json?    @map("tool_input")
  toolOutput     Json?    @map("tool_output")
  sqlExecuted    String?  @map("sql_executed")    
  rowsReturned   Int?     @map("rows_returned")
  model          String?
  inputTokens    Int?     @map("input_tokens")
  outputTokens   Int?     @map("output_tokens")
  latencyMs      Int?     @map("latency_ms")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  account        Account        @relation(fields: [accountId], references: [id])

  @@index([conversationId, createdAt(sort: Asc)])
  @@index([accountId, createdAt(sort: Desc)])
}

model AiInsight {
  id                String    @id @default(cuid())
  accountId         String
  insightType       String    // attendance_anomaly | absenteeism_spike | overtime_breach | contract_expiring | document_expiring | staffing_shortage | payroll_variance | compliance_due | invoice_overdue | leave_imbalance
  severity          String    @default("info") // info | low | medium | high | critical
  title             String       
  summary           String       
  recommendedAction String?       @map("recommended_action")
  entityTable       String?   @map("entity_table")
  entityId          String?   @map("entity_id")
  siteAssignmentId  String?   @map("site_assignment_id")
  employeeId        String?   @map("employee_id")
  evidence          Json?
  confidence        Float?
  acknowledgedBy    String?   @map("acknowledged_by")
  acknowledgedAt    DateTime? @map("acknowledged_at")
  resolvedAt        DateTime? @map("resolved_at")
  generatedBy       String    @default("ai") @map("generated_by")
  validUntil        DateTime? @map("valid_until")
  createdAt         DateTime  @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, severity, createdAt(sort: Desc)])
}

model AiUsageLedger {
  id              String   @id @default(cuid())
  accountId       String
  userId          String?
  agent           String
  usageDate       DateTime @default(now()) @map("usage_date")
  requestCount    Int      @default(1) @map("request_count")
  inputTokens     Int      @default(0) @map("input_tokens")
  outputTokens    Int      @default(0) @map("output_tokens")
  estimatedCostInr Float?   @map("estimated_cost_inr")
  createdAt       DateTime @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, usageDate(sort: Asc)])
}

// ============================================================
// CLIENT PORTAL — Phase 2
// ============================================================

model ClientBranding {
  id                  String   @id @default(cuid())
  accountId           String   @unique @map("account_id")
  displayName         String?  @map("display_name")
  logoUrl             String?  @map("logo_url")
  faviconUrl          String?  @map("favicon_url")
  primaryColor        String   @default("#16213E") @map("primary_color")
  accentColor         String   @default("#E8A33D") @map("accent_color")
  sidebarStyle        String   @default("dark") @map("sidebar_style")
  loginBackgroundUrl  String?  @map("login_background_url")
  supportEmail        String?  @map("support_email")
  supportPhone        String?  @map("support_phone")
  customDomain        String?  @map("custom_domain")
  customDomainVerified Boolean @default(false) @map("custom_domain_verified")
  hideHphrmsBranding  Boolean  @default(false) @map("hide_hphrms_branding")
  invoiceFooterNote   String?  @map("invoice_footer_note")
  updatedAt           DateTime @updatedAt @map("updated_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model ClientSite {
  id               String   @id @default(cuid())
  accountId        String
  siteCode         String
  siteName         String
  address          String?     
  city             String?
  state            String?
  geoLat           Float?
  geoLng           Float?
  geofenceRadiusM  Int      @default(200) @map("geofence_radius_m")
  siteInchargeName String?  @map("site_incharge_name")
  siteInchargePhone String? @map("site_incharge_phone")
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  timesheets Timesheet[]

  @@unique([accountId, siteCode])
  @@index([accountId])
}

model Timesheet {
  id               String    @id @default(cuid())
  accountId        String
  clientSiteId     String?   @map("client_site_id")
  periodStart      DateTime
  periodEnd        DateTime
  status           String    @default("draft") // draft | submitted | client_review | approved | disputed | invoiced
  totalMandays     Float     @default(0) @map("total_mandays")
  totalOvertimeHrs Float     @default(0) @map("total_overtime_hours")
  grossBillable    Float     @default(0) @map("gross_billable")
  submittedAt      DateTime? @map("submitted_at")
  submittedBy      String?   @map("submitted_by")
  clientApprovedAt DateTime? @map("client_approved_at")
  clientApprovedBy String?   @map("client_approved_by")
  clientRemarks    String?       @map("client_remarks")
  invoiceId        String?   @map("invoice_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  account     Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  clientSite  ClientSite?       @relation(fields: [clientSiteId], references: [id])
  lines       TimesheetLine[]

  @@unique([accountId, clientSiteId, periodStart, periodEnd])
  @@index([accountId, status])
}

model TimesheetLine {
  id             String  @id @default(cuid())
  timesheetId    String  @map("timesheet_id")
  employeeId     String  @map("employee_id")
  siteAssignmentId String? @map("site_assignment_id")
  daysPresent    Float   @default(0) @map("days_present")
  daysAbsent     Float   @default(0) @map("days_absent")
  overtimeHours  Float   @default(0) @map("overtime_hours")
  billableRate   Float   @map("billable_rate")
  overtimeRate   Float   @default(0) @map("overtime_rate")
  lineTotal      Float   @map("line_total")
  clientDisputed Boolean @default(false) @map("client_disputed")
  disputeNote    String?     @map("dispute_note")
  createdAt      DateTime @default(now()) @map("created_at")

  timesheet     Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
  employee      Employee? @relation(fields: [employeeId], references: [id])

  @@index([timesheetId])
}

  model GeneratedDocument {
  id               String   @id @default(cuid())
  accountId        String
  employeeId       String?
  documentType     String
  title            String
  storagePath      String?  @map("storage_path")
  fileFormat       String   @default("pdf") @map("file_format")
  templateId       String?
  generatedByUserId String? @map("generated_by_user_id")
  aiGenerated      Boolean  @default(true) @map("ai_generated")
  clientVisible    Boolean  @default(false) @map("client_visible")
  createdAt        DateTime  @default(now()) @map("created_at")

  account Account @relation("GeneratedDocAccount", fields: [accountId], references: [id], onDelete: Cascade)
  employee Employee? @relation("GeneratedDocEmployee", fields: [employeeId], references: [id])
}

// ============================================================
// SUPER ADMIN — SaaS Platform Models
// ============================================================

model ContentItem {
  id          String   @id @default(cuid())
  type        String   // faq | blog | career | banner | social | landing_section
  title       String
  slug        String?  @unique
  content     String?  // JSON string for flexible content
  status      String   @default("published") // published | draft | archived
  sortOrder   Int      @default(0)
  metadata    String?  // JSON string for extra fields
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type, status])
  @@index([sortOrder])
}

model CustomDomain {
  id          String   @id @default(cuid())
  domain      String   @unique
  sslStatus   String   @default("Pending") // Active | Pending | Failed
  verified    Boolean  @default(false)
  primary     Boolean  @default(false)
  accountId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([domain])
}

model BackupRecord {
  id          String   @id @default(cuid())
  fileName    String
  fileSize    String?
  backupType  String   @default("Manual") // Manual | Auto
  createdAt   DateTime @default(now())
}

model AiModelConfig {
  id          String   @id @default(cuid())
  name        String
  provider    String
  version     String?
  status      String   @default("Active") // Active | Beta | Deprecated
  capabilities String? // JSON array
  costPerK    Float?   @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PromptTemplate {
  id          String   @id @default(cuid())
  name        String
  category    String?
  description String?
  template    String?  // The actual prompt text
  variables   String?  // JSON array of variable names
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}
